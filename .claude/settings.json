{
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(chmod 777 *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(format *)",
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)",
      "Bash(DROP TABLE*)",
      "Bash(DROP DATABASE*)",
      "Bash(TRUNCATE TABLE*)",

      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.dev)",
      "Read(./**/.env.dev)",
      "Read(./.env.prod)",
      "Read(./**/.env.prod)",
      "Read(./.env.bak)",
      "Read(./**/.env.bak)",
      "Read(./.env.backup)",
      "Read(./**/.env.backup)",
      "Read(./.env.old)",
      "Read(./**/.env.old)",
      "Read(./.env.secret)",
      "Read(./**/.env.secret)",
      "Read(./.env.keys)",
      "Read(./**/.env.keys)",

      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.crt)",
      "Read(./**/*.cer)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/*.ppk)",

      "Read(./.claude/settings.local.json)",

      "Read(./**/.netrc)",
      "Read(./**/.htpasswd)",
      "Read(./**/credentials.json)",
      "Read(./**/token.json)",
      "Read(./**/auth.json)",
      "Read(./**/secrets.json)",
      "Read(./**/secret.json)",
      "Read(./**/*_credentials.json)",
      "Read(./**/*_secret.json)",

      "Read(./**/.aws/credentials)",
      "Read(./**/.aws/config)",
      "Read(./**/firebase-adminsdk*.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/serviceAccount*.json)",

      "Read(./**/*.kdbx)",
      "Read(./**/*.1pux)",

      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(./**/*.db)",

      "Read(./**/*.log)"
    ]
  }
}
